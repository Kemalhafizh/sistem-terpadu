APP_NAME="SISTA SMA ISA 1"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
# For local development with SQLite:
DB_CONNECTION=sqlite

# For Docker / production, use MySQL:
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=school_db
# DB_USERNAME=school_user
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=sistem-terpadu
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Integrasi & keamanan (dibaca lewat config/, aman untuk `config:cache`) ---
# Hanya akun Google dengan domain ini yang boleh login SSO (kosong = semua domain)
GOOGLE_SSO_DOMAIN=
# Fonnte WhatsApp gateway — pengaturan admin (Pengaturan > WhatsApp) diutamakan
WHATSAPP_API_TOKEN=
WHATSAPP_GATEWAY_SANDBOX=true
# IP yang boleh melewati middleware `admin.ip` (pisahkan dengan koma, "*" = semua)
ADMIN_ALLOWED_IPS=127.0.0.1,::1

# --- Push notification (Firebase Cloud Messaging HTTP v1) ---
# Path ke file JSON service account (Firebase Console > Project settings > Service accounts),
# atau isi JSON-nya langsung. Kosong = push hanya dicatat di log.
FCM_CREDENTIALS=
# Opsional; default diambil dari project_id di file kredensial
FCM_PROJECT_ID=
# Pengingat guru sebelum sesi kelas mulai/selesai (menit) & jam rangkuman harian orang tua
CLASS_SESSION_REMINDER_LEAD_MINUTES=5
CLASS_SESSION_PARENT_DIGEST_TIME=17:00

# Midtrans (pembayaran online). MIDTRANS_SIMULATOR=true hanya untuk demo lokal:
# gateway tiruan yang menandai tagihan lunas; tidak pernah aktif di production.
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SIMULATOR=false
